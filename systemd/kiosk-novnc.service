[Unit]
Description=Kiosk noVNC web bridge (browser-based VNC viewer)
After=kiosk-vnc.service
Requires=kiosk-vnc.service

[Service]
Type=simple
EnvironmentFile=-%h/kiosk/kiosk.conf
ExecStart=/bin/sh -c 'exec "$(command -v novnc_proxy || echo /usr/share/novnc/utils/novnc_proxy)" --vnc "localhost:${KIOSK_VNC_PORT:-5900}" --listen "${KIOSK_NOVNC_PORT:-6080}" --web /usr/share/novnc'
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
