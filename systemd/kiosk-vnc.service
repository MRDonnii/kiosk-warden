[Unit]
Description=Kiosk VNC sharing (x11vnc) for the active desktop
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
EnvironmentFile=-%h/kiosk/kiosk.conf
ExecStartPre=%h/kiosk/sync-vnc-password.sh
ExecStart=/bin/sh -c 'exec /usr/bin/x11vnc -display :0 -auth guess -rfbauth "$HOME/.vnc/passwd" -forever -shared -rfbport "${KIOSK_VNC_PORT:-5900}" -no6 -noxdamage -repeat -quiet'
SuccessExitStatus=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
